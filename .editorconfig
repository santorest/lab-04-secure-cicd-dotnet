root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,xml,props,csproj,slnx}]
indent_size = 2

# Test method names use underscores for readability (CA1707 is about public API naming).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
