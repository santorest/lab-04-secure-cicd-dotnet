{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tickets": "Data Source=tickets.db"
  },
  "Jwt": {
    "Issuer": "ticket-api",
    "Audience": "ticket-api",
    "LifetimeMinutes": 15
  },
  "RateLimits": {
    "LoginPerMinute": 5
  },
  "Seed": {
    "Enabled": false
  }
}
